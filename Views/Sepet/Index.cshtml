@model List<SepetOgesi>
@{
    ViewData["Title"] = "Sepetim";
    var toplam = Model.Sum(x => x.Urun.Fiyat * x.Adet);
}

<h3 class="tm-baslik">Sepetim</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Sepetiniz boş. <a asp-controller="Home" asp-action="Index">Alışverişe başla</a>
    </div>
}
else
{
    <div class="tm-kutu p-0 overflow-hidden mb-3"><table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th>Ürün</th>
                <th>Birim Fiyat</th>
                <th style="width:220px">Adet</th>
                <th>Tutar</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.Urun.Ad</td>
                    <td>@o.Urun.Fiyat.ToString("F2") ₺</td>
                    <td>
                        <form asp-action="Guncelle" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="number" name="adet" value="@o.Adet" min="1" max="@o.Urun.Stok" class="form-control form-control-sm" />
                            <button class="btn btn-sm btn-outline-secondary">Güncelle</button>
                        </form>
                    </td>
                    <td>@((o.Urun.Fiyat * o.Adet).ToString("F2")) ₺</td>
                    <td>
                        <form asp-action="Sil" method="post">
                            <input type="hidden" name="id" value="@o.Id" />
                            <button class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>

    <div class="d-flex justify-content-between align-items-center">
        <h4>Toplam: @toplam.ToString("F2") ₺</h4>
        <form asp-action="SatinAl" method="post">
            <button class="btn btn-success btn-lg">Satın Al</button>
        </form>
    </div>
}
