<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TeknoMarket</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark tm-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand tm-logo" asp-controller="Home" asp-action="Index">
            TeknoMarket
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i> Ürünler</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Sepet" asp-action="Index"><i class="bi bi-cart3"></i> Sepetim</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Siparis" asp-action="Index"><i class="bi bi-bag-check"></i> Siparişlerim</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link admin" asp-controller="Admin" asp-action="Urunler"><i class="bi bi-box-seam"></i> Ürün Yönetimi</a></li>
                    <li class="nav-item"><a class="nav-link admin" asp-controller="Admin" asp-action="Kullanicilar"><i class="bi bi-people"></i> Kullanıcılar</a></li>
                    <li class="nav-item"><a class="nav-link admin" asp-controller="Admin" asp-action="Siparisler"><i class="bi bi-receipt"></i> Tüm Siparişler</a></li>
                }
            </ul>
            <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="tm-kullanici"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Cikis" method="post">
                        <button class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Çıkış</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Giris">Giriş</a>
                    <a class="btn btn-gradient btn-sm" asp-controller="Account" asp-action="Kayit">Kayıt Ol</a>
                }
            </div>
        </div>
    </div>
</nav>

<main class="container mt-4 mb-4">
    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle"></i> @TempData["Mesaj"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @TempData["Hata"]</div>
    }
    @RenderBody()
</main>

<footer class="tm-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
        <span><strong class="text-white">TeknoMarket</strong> &copy; @DateTime.Now.Year</span>
        <span><i class="bi bi-truck"></i> Hızlı teslimat &nbsp; <i class="bi bi-shield-check"></i> Güvenli alışveriş</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
