@model List<Siparis>

@if (!Model.Any())
{
    <div class="alert alert-info">Sipariş bulunamadı.</div>
}
@foreach (var s in Model)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between">
            <span>
                Sipariş #@s.Id - @s.Tarih.ToString("dd.MM.yyyy HH:mm")
                @if (s.Kullanici != null)
                {
                    <span> - @s.Kullanici.AdSoyad</span>
                }
            </span>
            <strong>@s.Toplam.ToString("F2") ₺</strong>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var k in s.Kalemler)
            {
                <li class="list-group-item">
                    @k.UrunAdi × @k.Adet — @((k.BirimFiyat * k.Adet).ToString("F2")) ₺
                </li>
            }
        </ul>
    </div>
}
