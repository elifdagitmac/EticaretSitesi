@{
    ViewData["Title"] = "Kayıt Ol";
}
<div class="tm-auth tm-kutu">
    <div class="ikon"><i class="bi bi-person-plus"></i></div>
    <h3 class="tm-baslik">Hesap oluştur</h3>
    <p class="text-secondary">Kaydın yönetici onayından sonra aktif olur.</p>

    @if (ViewBag.Hata != null)
    {
        <div class="alert alert-danger">@ViewBag.Hata</div>
    }
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Ad Soyad</label>
            <input name="adSoyad" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">E-posta</label>
            <input name="email" type="email" class="form-control" placeholder="ornek@mail.com" required />
        </div>
        <div class="mb-4">
            <label class="form-label">Şifre (en az 6 karakter)</label>
            <input name="sifre" type="password" class="form-control" minlength="6" required />
        </div>
        <button class="btn btn-gradient w-100 py-2">Kayıt Ol</button>
    </form>
    <p class="text-center text-secondary small mt-3 mb-0">
        Zaten hesabın var mı? <a asp-action="Giris">Giriş yap</a>
    </p>
</div>
