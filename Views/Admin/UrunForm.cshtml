@model Urun
@{
    ViewData["Title"] = "Ürün Formu";
}

<h3 class="tm-baslik">@ViewBag.Baslik</h3>

<form method="post" class="col-lg-6 tm-kutu">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Ad" class="form-label"></label>
        <input asp-for="Ad" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Aciklama" class="form-label"></label>
        <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Fiyat" class="form-label"></label>
        <input asp-for="Fiyat" type="number" step="0.01" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Stok" class="form-label"></label>
        <input asp-for="Stok" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ResimUrl" class="form-label"></label>
        <input asp-for="ResimUrl" class="form-control" />
    </div>
    <div class="form-check mb-3">
        <input asp-for="SatistaMi" class="form-check-input" />
        <label asp-for="SatistaMi" class="form-check-label"></label>
    </div>

    <button class="btn btn-success">Kaydet</button>
    <a asp-action="Urunler" class="btn btn-secondary">İptal</a>
</form>
